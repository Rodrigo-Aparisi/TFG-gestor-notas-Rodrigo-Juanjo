# Server Configuration
PORT=3001

# Database Configuration
DB_USER=your_database_user
DB_HOST=localhost
DB_NAME=olympus_scribe
DB_PASSWORD=your_secure_database_password
DB_PORT=5432

# Environment
NODE_ENV=development
API_URL=http://localhost:3001
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Security - IMPORTANT: Generate new secure values for production
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Frontend URL (used for CORS in development)
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:3001

# CORS: comma-separated list of allowed origins (overrides FRONTEND_URL if set)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
DEBUG=false

# Email Configuration (Gmail)
# Generate app password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Application URLs
APP_URL=http://localhost:3000
APP_URL_2=http://localhost:3001


# PostgreSQL pool tuning (optional)
PG_POOL_MAX=10
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=2000

# ==============================================================================
# SECURITY NOTES:
# ==============================================================================
# 1. NEVER commit the real .env file to git
# 2. Copy this file to .env and fill with your actual values
# 3. For production, use strong randomly generated values:
#    - JWT_SECRET: At least 64 characters, use crypto.randomBytes(64).toString('hex')
#    - DB_PASSWORD: Strong password with uppercase, lowercase, numbers, symbols
#    - EMAIL_APP_PASSWORD: Generate from Google Account settings
# 4. Rotate all secrets regularly (every 3-6 months minimum)
# ==============================================================================
